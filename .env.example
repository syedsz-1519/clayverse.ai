# ===================================
# FIREBASE CONFIGURATION (Phase 3d)
# ===================================
# Get these from Firebase Console: https://console.firebase.google.com

# Firebase API Key
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Firebase Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (Analytics)
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Emulator (Development Only - set to true if running locally)
VITE_USE_FIREBASE_EMULATOR=false

# ===================================
# VIDEO INTEGRATION
# ===================================
# Google Video API (Optional - uses mock videos if not provided)
VITE_GOOGLE_VIDEO_API_KEY=your_google_video_api_key_here

# ===================================
# AI/LLM SERVICES
# ===================================
# Google Gemini API (for enhanced Clay assistant)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===================================
# PAYMENT PROCESSING (Future)
# ===================================
# Stripe Public Key (for premium subscriptions)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key

# ===================================
# ANALYTICS & MONITORING
# ===================================
# Mixpanel (for user analytics)
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# Sentry (for error tracking)
VITE_SENTRY_DSN=your_sentry_dsn

# ===================================
# APP CONFIGURATION
# ===================================
# App environment (development, staging, production)
VITE_APP_ENV=development

# App URL
VITE_APP_URL=http://localhost:3000

# API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
